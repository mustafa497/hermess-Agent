# Copy to .env. Every value is optional; config.yaml supplies the defaults.
# Nested keys use a double underscore: HERMES_<SECTION>__<FIELD>

# --- convenience aliases (flat) ---
HERMES_MODEL=hermes3:8b
HERMES_HOST=http://localhost:11434
HERMES_WORKSPACE_DIR=./workspace
HERMES_LOG_LEVEL=INFO

# --- full nested form ---
# HERMES_OLLAMA__MODEL=hermes3:70b
# HERMES_OLLAMA__EMBED_MODEL=nomic-embed-text
# HERMES_OLLAMA__NUM_CTX=16384
# HERMES_OLLAMA__TEMPERATURE=0.2
# HERMES_OLLAMA__SEED=42
# HERMES_OLLAMA__KEEP_ALIVE=15m
# HERMES_OLLAMA__REQUEST_TIMEOUT_S=300

# HERMES_AGENT__MAX_ITERATIONS=10
# HERMES_AGENT__MAX_TOOL_CALLS_PER_TURN=5

# HERMES_SAFETY__ALLOW_DESTRUCTIVE=false
# HERMES_SAFETY__PYTHON_TIMEOUT_S=20

# HERMES_MEMORY__LONG_TERM_ENABLED=false
